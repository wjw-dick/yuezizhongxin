.dash {
  margin: -24rpx -28rpx 20rpx;
  border-radius: 0 0 32rpx 32rpx;
}

.ring {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
}
.ring::after {
  content: '';
  position: absolute;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #1e5344;
}
.ring-num { position: relative; z-index: 1; font-size: 28rpx; color: #fff; font-weight: 600; }
.ring-label { position: relative; z-index: 1; font-size: 18rpx; color: #bcdccb; }

.clock-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 28rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.18);
}
.clock-item { flex: 1; }
.clock-label { display: block; font-size: 20rpx; color: #a9c9b9; }
.clock-value { display: block; font-size: 24rpx; color: #ffffff; margin-top: 2rpx; }
.clock-btn {
  padding: 0 26rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #1e5344;
  font-size: 25rpx;
  font-weight: 600;
}
.clock-btn.off { opacity: 0.6; }

.stats {
  display: flex;
  gap: 14rpx;
  margin-bottom: 8rpx;
}
.stat {
  flex: 1;
  background: #ffffff;
  border: 1rpx solid #ece7db;
  border-radius: 18rpx;
  padding: 20rpx 12rpx;
  text-align: center;
}
.stat-num {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #1f2421;
  font-variant-numeric: tabular-nums;
}
.stat-num.warn { color: #b4741f; }
.stat-label { font-size: 21rpx; color: #8d968f; }

.section-head { margin-top: 28rpx; align-items: baseline; }
.section-title { margin: 0; }

.task-list { margin-top: 16rpx; }
.task { padding: 24rpx; }
.task.done { opacity: 0.72; }
.slot {
  font-size: 24rpx;
  color: #246a54;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}
.task-name { font-size: 29rpx; color: #1f2421; }
.task-meta { display: flex; gap: 8rpx; margin-top: 10rpx; }
.task-action {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #f2eee5;
}
.go { color: #b6bdb6; }

.alert-card {
  margin-top: 24rpx;
  padding: 22rpx 24rpx;
  border-radius: 18rpx;
  background: #fdf5e8;
  border: 1rpx solid #f1e2c6;
}
.alert-title { display: block; font-size: 27rpx; color: #9a6a18; font-weight: 600; }
.alert-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #a8814a;
  line-height: 1.6;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.quick {
  display: flex;
  gap: 14rpx;
  margin-top: 32rpx;
}
.quick-item {
  flex: 1;
  background: #ffffff;
  border: 1rpx solid #ece7db;
  border-radius: 18rpx;
  padding: 22rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  font-size: 23rpx;
  color: #414a45;
}
.q-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 14rpx;
  background: #f0f8f4;
  color: #246a54;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
