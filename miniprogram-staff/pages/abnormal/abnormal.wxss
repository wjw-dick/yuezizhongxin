.head { align-items: center; margin-bottom: 20rpx; }
.tabs { display: flex; gap: 12rpx; }
.tab {
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  background: #ffffff;
  border: 1rpx solid #e6e1d6;
  font-size: 25rpx;
  color: #6b746f;
}
.tab.on { background: #246a54; border-color: #246a54; color: #ffffff; }

.item { padding: 24rpx; }
.item.urgent { border-color: #f1d9b4; background: #fffdf8; }
.type { font-size: 28rpx; color: #1f2421; font-weight: 600; }
.desc {
  display: block;
  margin-top: 14rpx;
  font-size: 26rpx;
  color: #414a45;
  line-height: 1.7;
}
.handle {
  margin-top: 16rpx;
  padding: 16rpx 18rpx;
  background: #f5f8f5;
  border-radius: 14rpx;
}
.handle-label { display: block; font-size: 21rpx; color: #8d968f; }
.handle-text { font-size: 25rpx; color: #246a54; line-height: 1.6; }
.foot { margin-top: 16rpx; }

.tip { display: block; margin-bottom: 20rpx; }
.warn-text { color: #a8814a; display: block; margin-top: 8rpx; }

.mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(31, 36, 33, 0.45);
  z-index: 20;
  display: flex;
  align-items: flex-end;
}
.sheet {
  width: 100%;
  max-height: 88vh;
  background: #fbf9f5;
  border-radius: 32rpx 32rpx 0 0;
  padding: 28rpx;
  box-sizing: border-box;
  overflow-y: auto;
}
.sheet-head { margin-bottom: 12rpx; }
.chips { display: flex; flex-wrap: wrap; gap: 12rpx; }
.chip { margin: 0; }
