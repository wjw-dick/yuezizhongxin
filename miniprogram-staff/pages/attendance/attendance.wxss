.profile-hero {
  margin: -24rpx -28rpx 12rpx;
  border-radius: 0 0 32rpx 32rpx;
}
.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  color: #ffffff;
  font-size: 38rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.clock-row {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.18);
}
.clock-btn { flex: 1; }
.profile-hero .btn.ghost {
  background: rgba(255, 255, 255, 0.16);
  border-color: rgba(255, 255, 255, 0.3);
  color: #ffffff;
}

.line {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f2eee5;
}
.line:last-child { border-bottom: none; }
.date { font-size: 27rpx; color: #1f2421; }
.time { font-size: 24rpx; color: #414a45; }
.right { align-items: flex-end; }

.note { margin-top: 24rpx; }
.note-title { display: block; font-size: 26rpx; color: #1f2421; margin-bottom: 6rpx; }
.note-text { line-height: 1.7; }

.logout { margin-top: 40rpx; }
