.login-wrap {
  min-height: 100vh;
  padding: 80rpx 40rpx 60rpx;
  background: linear-gradient(170deg, #1e5344 0%, #2f7d64 42%, #f7f6f2 42.1%, #f7f6f2 100%);
  box-sizing: border-box;
}

.brand { margin-bottom: 48rpx; }
.brand-mark {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.18);
  color: #ffffff;
  font-size: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}
.brand-name {
  display: block;
  font-size: 42rpx;
  color: #ffffff;
  font-weight: 600;
  letter-spacing: 4rpx;
}
.brand-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #bcdccb;
}

.login-card { padding: 32rpx 28rpx; }
.tip {
  margin: -8rpx 0 18rpx;
  padding: 14rpx 18rpx;
  background: #fdf5e8;
  border-radius: 14rpx;
  color: #9a6a18;
  font-size: 23rpx;
  line-height: 1.6;
}
.note { display: block; margin-top: 20rpx; line-height: 1.7; }

.safe-note {
  margin-top: 48rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.72);
  font-size: 22rpx;
  color: #6b746f;
  line-height: 1.7;
  border: 1rpx solid #ece7db;
}
