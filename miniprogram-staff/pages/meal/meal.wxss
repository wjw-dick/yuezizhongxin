.tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
}
.tab {
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  background: #ffffff;
  border: 1rpx solid #e6e1d6;
  font-size: 25rpx;
  color: #6b746f;
}
.tab.on { background: #246a54; border-color: #246a54; color: #ffffff; }

.room { padding: 24rpx; }
.room-head {
  padding-bottom: 14rpx;
  border-bottom: 1rpx solid #f2eee5;
  margin-bottom: 10rpx;
}
.room-no { font-size: 29rpx; font-weight: 600; color: #1f2421; }

.meal { padding: 16rpx 0; border-bottom: 1rpx dashed #f2eee5; }
.meal:last-child { border-bottom: none; }
.meal-type {
  font-size: 25rpx;
  color: #246a54;
  font-weight: 600;
}
.dishes {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #414a45;
  line-height: 1.7;
}
.abnormal {
  display: block;
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #b4741f;
}
.check {
  padding: 6rpx 22rpx;
  border-radius: 999rpx;
  background: #eef7f2;
  color: #246a54;
  font-size: 24rpx;
}
