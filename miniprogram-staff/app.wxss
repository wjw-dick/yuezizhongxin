/* 全局样式：暖白底 + 墨绿主色，卡片化布局 */
page {
  background: #fbf9f5;
  color: #414a45;
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
  line-height: 1.7;
}

.wrap { padding: 24rpx 28rpx 60rpx; }
.row { display: flex; align-items: center; }
.between { display: flex; align-items: center; justify-content: space-between; }
.col { display: flex; flex-direction: column; }
.gap8 { gap: 8rpx; }
.gap12 { gap: 12rpx; }
.gap16 { gap: 16rpx; }
.gap24 { gap: 24rpx; }
.grow { flex: 1; }

.title { font-size: 36rpx; font-weight: 600; color: #1f2421; }
.subtitle { font-size: 26rpx; color: #6b746f; }
.section-title { font-size: 32rpx; font-weight: 600; color: #1f2421; margin: 32rpx 0 16rpx; }
.muted { color: #8d968f; font-size: 24rpx; }
.mono { font-family: Menlo, monospace; }
.price { color: #246a54; font-weight: 600; font-variant-numeric: tabular-nums; }
.bronze { color: #a87f3a; }

.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(31, 36, 33, 0.05);
  border: 1rpx solid #eee9de;
}
.card + .card { margin-top: 20rpx; }

.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: #f0f8f4;
  color: #246a54;
  font-size: 22rpx;
}
.tag.bronze { background: #f3e7cf; color: #a87f3a; }
.tag.warn { background: #fdf5e8; color: #9a6a18; }
.tag.muted { background: #f4f3ef; color: #6b746f; }

.btn {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 30rpx;
  background: #246a54;
  color: #ffffff;
  border: none;
}
.btn.ghost {
  background: #ffffff;
  color: #246a54;
  border: 1rpx solid #d8ece3;
  line-height: 86rpx;
}
.btn[disabled] { background: #c9d3cc; color: #ffffff; }
.btn.sm { height: 64rpx; line-height: 64rpx; font-size: 26rpx; padding: 0 28rpx; display: inline-block; }

.field { margin-bottom: 22rpx; }
.field .label { font-size: 25rpx; color: #6b746f; margin-bottom: 10rpx; display: block; }
.field input, .field textarea, .field picker {
  width: 100%;
  background: #faf8f4;
  border: 1rpx solid #e6e1d6;
  border-radius: 16rpx;
  padding: 20rpx 22rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  color: #1f2421;
}
.field textarea { min-height: 160rpx; }
.picker-box {
  width: 100%;
  background: #faf8f4;
  border: 1rpx solid #e6e1d6;
  border-radius: 16rpx;
  padding: 20rpx 22rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  color: #1f2421;
}
.placeholder { color: #b6bdb6; }

.empty { text-align: center; padding: 80rpx 0; color: #8d968f; font-size: 26rpx; }
.empty .strong { display: block; color: #414a45; font-size: 30rpx; margin-bottom: 8rpx; }

.divider { height: 1rpx; background: #eee9de; margin: 20rpx 0; }

.hero {
  padding: 40rpx 28rpx 36rpx;
  background: linear-gradient(150deg, #1e5344, #2f7d64 62%, #4fae8d);
  color: #eef6f1;
  border-radius: 0 0 32rpx 32rpx;
}
.hero .title { color: #ffffff; font-size: 42rpx; }
.hero .subtitle { color: #c7ded2; }

.grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; }
.thumb { width: 100%; height: 260rpx; border-radius: 18rpx; background: #f1eee6; }
.thumb-ph { display: flex; align-items: center; justify-content: center; color: #b6bdb6; font-size: 24rpx; }

.chip {
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  background: #ffffff;
  border: 1rpx solid #e6e1d6;
  font-size: 25rpx;
  color: #6b746f;
  margin-right: 12rpx;
  margin-bottom: 12rpx;
  display: inline-block;
}
.chip.on { background: #246a54; border-color: #246a54; color: #ffffff; }

.bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 28rpx 28rpx;
  background: #ffffff;
  border-top: 1rpx solid #eee9de;
  display: flex;
  align-items: center;
  gap: 18rpx;
}
.bar .btn { flex: 1; }
.pb-bar { padding-bottom: 160rpx; }

.progress { height: 12rpx; background: #eee9de; border-radius: 999rpx; overflow: hidden; }
.progress .inner { height: 100%; background: linear-gradient(90deg, #4fae8d, #2f8b70); }
