.chips { padding: 8rpx 0 20rpx; }
.room { margin-bottom: 20rpx; }
.room-head { display: flex; align-items: center; justify-content: space-between; margin-top: 16rpx; }
.room-name { font-size: 32rpx; font-weight: 600; color: #1f2421; }
.room-fac { display: block; margin-top: 6rpx; }
.room-foot { margin-top: 16rpx; padding-top: 16rpx; border-top: 1rpx solid #f1eee6; font-size: 25rpx; }

.pkg { margin-bottom: 18rpx; }
.pkg-name { font-size: 30rpx; font-weight: 600; color: #1f2421; }
.pkg .price { font-size: 34rpx; }
.pkg-meta { display: flex; flex-wrap: wrap; gap: 10rpx; margin: 14rpx 0; }
.pkg-rehab { display: block; margin-bottom: 16rpx; }

.mask { position: fixed; inset: 0; background: rgba(20,26,23,0.48); display: flex; align-items: flex-end; z-index: 20; }
.sheet { width: 100%; max-height: 84vh; background: #fff; border-radius: 32rpx 32rpx 0 0; padding: 28rpx; box-sizing: border-box; overflow-y: auto; }
.sheet-head { margin-bottom: 18rpx; }
.gallery { white-space: nowrap; margin-bottom: 18rpx; }
.gallery-img { width: 300rpx; height: 220rpx; border-radius: 18rpx; margin-right: 14rpx; background: #f1eee6; display: inline-block; }
.sheet-fac { display: block; margin: 14rpx 0; }
.sheet-desc { font-size: 27rpx; color: #414a45; line-height: 1.8; margin-bottom: 22rpx; display: block; }
