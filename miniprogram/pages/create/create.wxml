<view class="wrap pb-bar">
  <view class="card">
    <text class="title">下单</text>
    <text class="muted tip">入住日期会实时校验档期，提交后系统为您锁定房间。</text>

    <view class="field">
      <text class="label">套餐</text>
      <picker range="{{packages}}" range-key="name" value="{{packageIndex}}" bindchange="onPackage">
        <view class="picker-box">{{packages[packageIndex].name || '请选择套餐'}}</view>
      </picker>
    </view>
    <view class="field">
      <text class="label">房型</text>
      <picker range="{{rooms}}" range-key="name" value="{{roomIndex}}" bindchange="onRoom">
        <view class="picker-box">{{rooms[roomIndex].name || '请选择房型'}}</view>
      </picker>
    </view>
    <view class="field">
      <text class="label">入住日期</text>
      <picker mode="date" value="{{checkinDate}}" start="{{checkinDate}}" bindchange="onCheckin">
        <view class="picker-box">{{checkinDate}}</view>
      </picker>
    </view>
    <view class="field">
      <text class="label">离馆日期（按套餐天数自动计算）</text>
      <view class="picker-box">{{checkoutDate}}</view>
    </view>
    <view class="field">
      <text class="label">护理模式</text>
      <picker range="{{careModes}}" value="{{careIndex}}" bindchange="onCare">
        <view class="picker-box">{{careModes[careIndex]}}</view>
      </picker>
    </view>
    <view class="field">
      <text class="label">陪护人数</text>
      <input type="number" value="{{form.companionCount}}" data-key="companionCount" bindinput="onInput" />
    </view>
    <view class="field">
      <text class="label">产妇姓名 *</text>
      <input placeholder="与证件一致" value="{{form.customerName}}" data-key="customerName" bindinput="onInput" />
    </view>
    <view class="field">
      <text class="label">手机号 *</text>
      <input type="number" maxlength="11" placeholder="用于接收订单与支付通知" value="{{form.phone}}" data-key="phone" bindinput="onInput" />
    </view>
    <view class="field">
      <text class="label">备注</text>
      <textarea placeholder="如忌口、特殊护理需求" value="{{form.remark}}" data-key="remark" bindinput="onInput" />
    </view>
  </view>

  <view class="card">
    <view class="between">
      <text class="muted">套餐总价</text>
      <text class="price">¥{{total}}</text>
    </view>
    <view class="between" style="margin-top: 12rpx">
      <text class="muted">本次支付定金</text>
      <text class="price">¥{{deposit}}</text>
    </view>
    <text class="muted deposit-note">定金支付成功后档期立即锁定；尾款与押金在入馆/出馆时结算。</text>
  </view>
</view>

<view class="bar">
  <view class="col" style="flex: 0 0 200rpx">
    <text class="muted" style="font-size: 22rpx">应付定金</text>
    <text class="price" style="font-size: 36rpx">¥{{deposit}}</text>
  </view>
  <view class="btn" bindtap="submit" disabled="{{submitting}}">{{submitting ? '提交中…' : '支付定金并锁档'}}</view>
</view>
