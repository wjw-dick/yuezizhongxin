.seg-top {
  display: flex;
  gap: 12rpx;
  margin-bottom: 8rpx;
}
.seg-btn {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 18rpx;
  background: #ffffff;
  border: 1rpx solid #e6e1d6;
  font-size: 27rpx;
  color: #6b746f;
}
.seg-btn.on {
  background: #246a54;
  border-color: #246a54;
  color: #ffffff;
  font-weight: 600;
}

.course { padding: 22rpx; }
.course-name { font-size: 26rpx; color: #1f2421; }
.course-remain { margin: 10rpx 0 12rpx; align-items: baseline; }
.price.big { font-size: 44rpx; }
.course-meta { display: block; margin-top: 8rpx; font-size: 22rpx; }

.appoint-btn { margin-top: 28rpx; }

.line {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f2eee5;
}
.line:last-child { border-bottom: none; }
.line.col { flex-direction: column; align-items: flex-start; gap: 6rpx; }
.line-title { font-size: 27rpx; color: #1f2421; }
.cancel { color: #b4543e; font-size: 24rpx; }
.assess-report { line-height: 1.6; }

.meal-head { margin-top: 24rpx; }
.no-margin { margin: 0; }
.meal-row {
  display: flex;
  gap: 18rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f2eee5;
}
.meal-row:last-child { border-bottom: none; }
.meal-type {
  width: 90rpx;
  flex-shrink: 0;
  font-size: 25rpx;
  color: #246a54;
  font-weight: 600;
}
.meal-dish { font-size: 27rpx; color: #1f2421; line-height: 1.6; }
.meal-tags { margin-top: 10rpx; }

.meal-actions { margin-top: 24rpx; }
.restrict-content { font-size: 26rpx; color: #414a45; }

.empty-btn { margin-top: 28rpx; width: 320rpx; display: inline-block; }

.mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(31, 36, 33, 0.45);
  z-index: 20;
  display: flex;
  align-items: flex-end;
}
.sheet {
  width: 100%;
  max-height: 88vh;
  background: #fbf9f5;
  border-radius: 32rpx 32rpx 0 0;
  padding: 28rpx;
  box-sizing: border-box;
  overflow-y: auto;
}
.sheet-head { margin-bottom: 8rpx; }
.sheet-tip { display: block; margin-bottom: 24rpx; }
.chips { display: flex; flex-wrap: wrap; gap: 12rpx; }
.chip { margin: 0; }
