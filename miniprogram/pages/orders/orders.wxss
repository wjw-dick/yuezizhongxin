.tabs {
  white-space: nowrap;
  margin: -8rpx -28rpx 8rpx;
  padding: 0 28rpx;
}
.tab {
  display: inline-block;
  padding: 12rpx 26rpx;
  margin-right: 12rpx;
  border-radius: 999rpx;
  background: #ffffff;
  border: 1rpx solid #e6e1d6;
  font-size: 26rpx;
  color: #6b746f;
}
.tab.on { background: #246a54; border-color: #246a54; color: #ffffff; }

.order { padding: 26rpx 24rpx; }
.order-no { font-size: 25rpx; color: #6b746f; }

.status {
  font-size: 24rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: #f0f8f4;
  color: #246a54;
}
.status.warn { background: #fdf5e8; color: #9a6a18; }
.status.live { background: #e9f5ef; color: #1e5344; font-weight: 600; }
.status.muted { background: #f4f3ef; color: #8d968f; }

.dates { margin: 16rpx 0 6rpx; }
.date { font-size: 30rpx; color: #1f2421; font-variant-numeric: tabular-nums; }

.amount-row {
  display: flex;
  gap: 16rpx;
  margin: 20rpx 0 12rpx;
}
.amount { flex: 1; }
.amount-label { display: block; font-size: 22rpx; color: #8d968f; }
.paid { color: #1f2421; font-weight: 600; }

.rate-text { display: block; margin-top: 8rpx; }

.order-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
}
.more { font-size: 24rpx; }

.login-btn { margin-top: 32rpx; width: 340rpx; display: inline-block; }
.empty-btn { margin-top: 28rpx; width: 320rpx; display: inline-block; }

.mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(31, 36, 33, 0.45);
  z-index: 20;
  display: flex;
  align-items: flex-end;
}
.sheet {
  width: 100%;
  max-height: 88vh;
  background: #fbf9f5;
  border-radius: 32rpx 32rpx 0 0;
  padding: 28rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}
.sheet-head { margin-bottom: 12rpx; }
.sheet-body { flex: 1; max-height: 72vh; }

.kv {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  padding: 12rpx 0;
  font-size: 27rpx;
  color: #1f2421;
}
.kv.strong { border-top: 1rpx dashed #e6e1d6; margin-top: 8rpx; padding-top: 16rpx; font-weight: 600; }
.block-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #414a45;
  margin-bottom: 6rpx;
}
.link-row { border-bottom: 1rpx solid #f0ece3; }
.copy { color: #246a54; font-size: 24rpx; }

.detail-actions {
  margin: 36rpx 0 20rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}
