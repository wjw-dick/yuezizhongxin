# 生产 nginx：四个域名 + HTTPS + SPA 兜底 + API 反代 + 静态文件下载
#
# 证书放置：deploy/nginx/certs/fullchain.pem 与 privkey.pem
# 首次可用 certbot 签发：
#   certbot certonly --webroot -w /var/www/certbot -d www.example.com -d admin.example.com ...

upstream yzz_backend {
    server backend:8080;
    keepalive 32;
}

# HTTP 统一跳 HTTPS（保留 certbot 校验路径）
server {
    listen 80;
    listen [::]:80;
    server_name ${ADMIN_DOMAIN} ${SITE_DOMAIN} ${API_DOMAIN} ${H5_DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# 官网（PC 端，SEO 友好，history 路由兜底到 index.html）
server {
    listen 443 ssl http2;
    server_name ${SITE_DOMAIN};

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    add_header Strict-Transport-Security "max-age=31536000" always;

    root /usr/share/nginx/html/site;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~* \.(js|css|png|jpg|jpeg|webp|svg|woff2)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }
}

# 租户后台（管理端，禁止被搜索引擎收录）
server {
    listen 443 ssl http2;
    server_name ${ADMIN_DOMAIN};

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Robots-Tag "noindex, nofollow" always;

    root /usr/share/nginx/html/admin;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /api/ {
        proxy_pass http://yzz_backend;
        include /etc/nginx/conf.d/proxy_common.inc;
    }
}

# H5（移动端分享落地，hash 路由无需兜底但仍保留）
server {
    listen 443 ssl http2;
    server_name ${H5_DOMAIN};

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;

    root /usr/share/nginx/html/h5;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /api/ {
        proxy_pass http://yzz_backend;
        include /etc/nginx/conf.d/proxy_common.inc;
    }
}

# API（小程序、App、公众号回调统一入口）
server {
    listen 443 ssl http2;
    server_name ${API_DOMAIN};

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 20m;

    location /api/ {
        proxy_pass http://yzz_backend;
        include /etc/nginx/conf.d/proxy_common.inc;
    }

    location /actuator/health {
        proxy_pass http://yzz_backend;
        access_log off;
    }

    # 对象存储文件下载（本地存储时映射到共享卷）
    location /files/ {
        alias /usr/share/nginx/html/files/;
        add_header Content-Disposition "inline";
    }

    location / {
        return 404;
    }
}
