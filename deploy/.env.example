# 生产环境变量示例：复制为 deploy/.env 后填写真实值，切勿提交仓库
# cp deploy/.env.example deploy/.env && chmod 600 deploy/.env

# 域名
ADMIN_DOMAIN=admin.yuezizhongxin.com
SITE_DOMAIN=www.yuezizhongxin.com
API_DOMAIN=api.yuezizhongxin.com
H5_DOMAIN=m.yuezizhongxin.com

# 数据库与缓存
MYSQL_ROOT_PASSWORD=change-me-strong-password
REDIS_PASSWORD=change-me-redis-password

# 消息队列与对象存储
RABBITMQ_USER=yzz
RABBITMQ_PASSWORD=change-me-rabbit
MINIO_USER=yzzminio
MINIO_PASSWORD=change-me-minio
YZZ_STORAGE_DRIVER=local

# 应用密钥（务必替换，长度 ≥ 32）
TOKEN_SECRET=change-me-token-secret-at-least-32-chars
SECRET_KEY=change-me-aes-secret-at-least-32-chars

# 微信支付（未填写则走本地模拟支付，不会真实扣款）
WXPAY_MCH_ID=
WXPAY_SERIAL_NO=
WXPAY_PRIVATE_KEY=
WXPAY_API_V3_KEY=

# 公众号
MP_APPSECRET=

# 运维
BACKUP_KEEP_DAYS=14
GRAFANA_PASSWORD=change-me-grafana
