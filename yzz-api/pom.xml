<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.yzz</groupId>
    <artifactId>yzz-parent</artifactId>
    <version>1.0.0</version>
  </parent>

  <artifactId>yzz-api</artifactId>
  <name>yzz-api</name>
  <description>启动模块：装配全部业务模块，对外提供 REST 接口</description>

  <dependencies>
    <dependency>
      <groupId>com.yzz</groupId>
      <artifactId>yzz-common</artifactId>
    </dependency>
    <dependency>
      <groupId>com.yzz</groupId>
      <artifactId>yzz-tenant</artifactId>
    </dependency>
    <dependency>
      <groupId>com.yzz</groupId>
      <artifactId>yzz-system</artifactId>
    </dependency>
    <dependency>
      <groupId>com.yzz</groupId>
      <artifactId>yzz-platform</artifactId>
    </dependency>
    <dependency>
      <groupId>com.yzz</groupId>
      <artifactId>yzz-room</artifactId>
    </dependency>
    <dependency>
      <groupId>com.yzz</groupId>
      <artifactId>yzz-product</artifactId>
    </dependency>
    <dependency>
      <groupId>com.yzz</groupId>
      <artifactId>yzz-crm</artifactId>
    </dependency>
    <dependency>
      <groupId>com.yzz</groupId>
      <artifactId>yzz-order</artifactId>
    </dependency>
    <dependency>
      <groupId>com.yzz</groupId>
      <artifactId>yzz-stay</artifactId>
    </dependency>
    <dependency>
      <groupId>com.yzz</groupId>
      <artifactId>yzz-care</artifactId>
    </dependency>
    <dependency>
      <groupId>com.yzz</groupId>
      <artifactId>yzz-rehab</artifactId>
    </dependency>
    <dependency>
      <groupId>com.yzz</groupId>
      <artifactId>yzz-meal</artifactId>
    </dependency>
    <dependency>
      <groupId>com.yzz</groupId>
      <artifactId>yzz-staff</artifactId>
    </dependency>
    <dependency>
      <groupId>com.yzz</groupId>
      <artifactId>yzz-member</artifactId>
    </dependency>
    <dependency>
      <groupId>com.yzz</groupId>
      <artifactId>yzz-content</artifactId>
    </dependency>
    <dependency>
      <groupId>com.yzz</groupId>
      <artifactId>yzz-report</artifactId>
    </dependency>
    <dependency>
      <groupId>com.yzz</groupId>
      <artifactId>yzz-mp</artifactId>
    </dependency>
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>
  </dependencies>

  <build>
    <finalName>yzz-api</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>com.yzz.api.YzzApplication</mainClass>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
